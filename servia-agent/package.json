{
  "name": "servia-agent",
  "version": "0.1.0",
  "private": true,
  "description": "SERVIA AI customer service agent for WhatsApp, Instagram and Messenger",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "worker": "tsx --env-file-if-exists=.env src/cli/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "knowledge:reload": "tsx --env-file-if-exists=.env src/cli/reload-knowledge.ts",
    "simulate": "tsx --env-file-if-exists=.env src/cli/simulate.ts",
    "eval": "tsx --env-file-if-exists=.env src/cli/eval.ts",
    "data:purge": "tsx --env-file-if-exists=.env src/cli/purge.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
