# SERVIA agent configuration. Copy to .env and fill in. Never commit .env.
# Placeholders only — no real values belong in this file.

# --- Server ---------------------------------------------------------------
NODE_ENV=development            # development | test | production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=true                # true when running behind a load balancer / reverse proxy (needed for correct client IPs)

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://servia:servia@localhost:5432/servia
DATABASE_POOL_MAX=10
RUN_MIGRATIONS_ON_START=true    # apply pending migrations when the server starts
KNOWLEDGE_RELOAD_ON_START=true  # sync ./knowledge into the database when the server starts

# --- AI -------------------------------------------------------------------
AI_PROVIDER=offline             # openai | offline (offline = credential-free local simulation; rejected in production)
AI_MODEL=                       # required for openai, e.g. the model id your OpenAI account should use
OPENAI_API_KEY=                 # required for openai
AI_TIMEOUT_MS=20000             # per request
AI_MAX_RETRIES=2                # SDK retries with exponential backoff (connection errors, 429, 5xx)
AI_MAX_OUTPUT_TOKENS=500        # raise for reasoning models, which spend output tokens on reasoning
AI_HISTORY_MESSAGES=10          # prior messages sent as context

# --- Knowledge retrieval --------------------------------------------------
KNOWLEDGE_DIR=./knowledge
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_RANK=0.01         # passages ranked below this are not given to the model

# --- Conversation policy --------------------------------------------------
MAX_INBOUND_CHARS=2000                  # longer customer messages are truncated before processing
MAX_MESSAGES_PER_CONTACT_PER_HOUR=30    # beyond this the agent stops answering that contact for the hour
HUMAN_FOLLOWUP_TIMEFRAME=               # e.g. "within one business day". Empty = never promise a timeframe
RETENTION_DAYS=180                      # conversations idle longer than this are deleted by `npm run data:purge`

# --- Admin & simulator ----------------------------------------------------
ADMIN_API_TOKEN=                # >= 32 random chars (e.g. `openssl rand -hex 32`). Empty = admin API disabled
SIMULATOR_ENABLED=false         # POST /simulate (requires ADMIN_API_TOKEN)

# --- Worker (PostgreSQL job queue) ----------------------------------------
WORKER_ENABLED=true             # run the job worker inside the web process
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
JOB_MAX_ATTEMPTS=5              # send attempts before a reply is marked failed
JOB_BACKOFF_BASE_MS=2000        # exponential backoff base for retries
CONVERSATION_LOCK_RETRY_MS=3000

# --- HTTP limits ----------------------------------------------------------
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_MAX=300              # requests per window per client IP
RATE_LIMIT_WINDOW_MS=60000

# --- Meta (shared) --------------------------------------------------------
META_GRAPH_API_VERSION=v25.0    # confirm the current version in Meta's changelog before going live
META_GRAPH_BASE_URL=https://graph.facebook.com
META_SEND_TIMEOUT_MS=10000
META_APP_SECRET=                # Meta app secret: signs WhatsApp and Messenger webhooks

# --- WhatsApp Business Platform (Cloud API) -------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_VERIFY_TOKEN=          # any random string you also enter in the Meta app's webhook settings
WHATSAPP_ACCESS_TOKEN=          # System User access token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=       # the business phone number ID (not the phone number)

# --- Facebook Messenger ---------------------------------------------------
MESSENGER_ENABLED=false
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=    # Page access token with pages_messaging

# --- Instagram (Instagram API with Instagram Login) -----------------------
INSTAGRAM_ENABLED=false
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=         # Instagram user access token with instagram_business_manage_messages
INSTAGRAM_APP_SECRET=           # Instagram app secret; falls back to META_APP_SECRET if empty
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
